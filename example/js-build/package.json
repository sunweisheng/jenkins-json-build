{
  "name": "html-jest",
  "version": "3.2.0",
  "description": "Minimal Node, Jest and Gulp acceptance project",
  "private": true,
  "devDependencies": {
    "gulp": "5.0.1",
    "gulp-clean-css": "4.3.0",
    "gulp-rename": "2.1.0",
    "jest": "30.4.2"
  },
  "scripts": {
    "test": "jest --coverage",
    "build": "gulp"
  },
  "jest": {
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    }
  },
  "license": "ISC"
}
