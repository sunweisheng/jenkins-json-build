<?xml version="1.0" encoding="utf-8"?>

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Clean">

    <PropertyGroup>
        <SolutionFile Condition="'$(SolutionFile)' == ''">WinBuild.sln</SolutionFile>
        <UnitTestsDLL Condition="'$(UnitTestsDLL)' == ''">WinBuild.Tests.dll</UnitTestsDLL>
        <BuildBinDir Condition="'$(BuildBinDir)' == ''">$(MSBuildProjectDirectory)\BuildBin</BuildBinDir>
        <VSTestResultsDir Condition="'$(VSTestResultsDir)' == ''">$(MSBuildProjectDirectory)\TestResults</VSTestResultsDir>
        <CoverHtmlResultsDir Condition="'$(CoverHtmlResultsDir)' == ''">$(MSBuildProjectDirectory)\Cover</CoverHtmlResultsDir>
        <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
        <BuildPlatform Condition=" '$(BuildPlatform)' == '' ">Any CPU</BuildPlatform>
    </PropertyGroup>

    <!--编译前先清理相关目录-->
    <Target Name="Clean">
        <RemoveDir Directories="$(BuildBinDir)"/>
        <RemoveDir Directories="$(VSTestResultsDir)"/>
        <RemoveDir Directories="$(CoverHtmlResultsDir)"/>
    </Target>

    <!--创建相关目录，如编译产物、报告目录-->
    <Target Name="Init" DependsOnTargets="Clean">
        <MakeDir Directories="$(BuildBinDir)"/>
        <MakeDir Directories="$(VSTestResultsDir)"/>
        <MakeDir Directories="$(CoverHtmlResultsDir)"/>
    </Target>

    <!--执行编译任务-->
    <Target Name="Compile" DependsOnTargets="Init">
        <MSBuild Projects="$(SolutionFile)" Targets="Rebuild" Properties="OutDir=$(BuildBinDir)\;Configuration=$(Configuration);Platform=$(BuildPlatform)"/>
    </Target>

    <Target Name="ValidateUnitTestTools" BeforeTargets="RunUnitTestsInMs;RunUnitTestsWithCoverage">
        <Error Condition="'$(VSTestConsole)' == ''" Text="请通过 /p:VSTestConsole 指定 vstest.console.exe 的路径。"/>
        <Error Condition="!Exists('$(VSTestConsole)')" Text="找不到指定的 vstest.console.exe：$(VSTestConsole)"/>
    </Target>

    <Target Name="RunUnitTestsInMs" DependsOnTargets="Compile">
        <Exec Command="&quot;$(VSTestConsole)&quot; &quot;$(BuildBinDir)\$(UnitTestsDLL)&quot; /ResultsDirectory:&quot;$(VSTestResultsDir)&quot; /logger:trx"/>
    </Target>

    <Target Name="RunUnitTestsWithCoverage" DependsOnTargets="Compile">
        <Exec Command="&quot;$(VSTestConsole)&quot; &quot;$(BuildBinDir)\$(UnitTestsDLL)&quot; /ResultsDirectory:&quot;$(VSTestResultsDir)&quot; /EnableCodeCoverage /logger:trx"/>
    </Target>

    <Target Name="ValidateCoverageTools" BeforeTargets="RenameAndConvertFormat">
        <Error Condition="'$(CoverageToolsRoot)' == ''" Text="生成覆盖率报告需要通过 /p:CoverageToolsRoot 指定工具目录。"/>
        <Error Condition="!Exists('$(CoverageToolsRoot)\CoverToXml\CoverToXml.exe')" Text="找不到 CoverToXml.exe：$(CoverageToolsRoot)\CoverToXml\CoverToXml.exe"/>
        <Error Condition="!Exists('$(CoverageToolsRoot)\trx2html_0.7.3\0.7.3\RidoTasks.dll')" Text="找不到 RidoTasks.dll：$(CoverageToolsRoot)\trx2html_0.7.3\0.7.3\RidoTasks.dll"/>
        <Error Condition="!Exists('$(CoverageToolsRoot)\ReportGenerator.3.0.2\tools\ReportGenerator.exe')" Text="找不到 ReportGenerator.exe：$(CoverageToolsRoot)\ReportGenerator.3.0.2\tools\ReportGenerator.exe"/>
    </Target>

    <Target Name="RenameAndConvertFormat" DependsOnTargets="RunUnitTestsWithCoverage">
        <Exec Command="&quot;$(CoverageToolsRoot)\CoverToXml\CoverToXml.exe&quot; &quot;$(VSTestResultsDir)&quot;"/>
    </Target>

    <UsingTask TaskName="RidoTasks.trx2html" AssemblyFile="$(CoverageToolsRoot)\trx2html_0.7.3\0.7.3\RidoTasks.dll" Condition="'$(CoverageToolsRoot)' != ''" />
    <Target Name="CreateTRXReports" DependsOnTargets="RenameAndConvertFormat">
        <CreateItem Include="$(VSTestResultsDir)\*.trx">
            <Output TaskParameter="Include" ItemName="trxfiles"/>
        </CreateItem>
        <RidoTasks.trx2html FileName="%(trxfiles.Identity)" />
    </Target>

    <UsingTask TaskName="ReportGenerator" AssemblyFile="$(CoverageToolsRoot)\ReportGenerator.3.0.2\tools\ReportGenerator.exe" Condition="'$(CoverageToolsRoot)' != ''"/>
    <Target Name="GenerateCoverageHtmlReport" DependsOnTargets="CreateTRXReports">
        <ReportGenerator ReportFiles="$(VSTestResultsDir)\unittests.coverage.xml" TargetDirectory="$(CoverHtmlResultsDir)" ReportTypes="Html;Latex" SourceDirectories="$(VSTestResultsDir)" VerbosityLevel="Verbose"/>
    </Target>
</Project>
