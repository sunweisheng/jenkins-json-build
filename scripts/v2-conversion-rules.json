{
  "metadataNodes": ["RuntimeVariable", "GlobalVariable", "GlobalLogLevel"],
  "commandTypes": ["COMMAND_STATUS", "COMMAND_STDOUT"],
  "unsupportedTypes": [],
  "mappings": {
    "COMMAND_STATUS_FOR": "commandLoop",
    "COMMAND_STATUS_IF": "conditionalCommand",
    "COMMAND_STATUS_WITH_CREDENTIALS": "credentials",
    "BUILD_PARAMETER_DROP_DOWN_MENU": "choiceParameter",
    "JUNIT_PLUG_IN": "junit",
    "JACOCO_PLUG_IN": "jacoco",
    "SONAR_QUBE": "sonarqube",
    "JEST_COVERAGE_ANALYSIS": "coverageJest",
    "LLVM_COV_COVERAGE_ANALYSIS": "coverageLlvm",
    "MSBUILD_COVERAGE_ANALYSIS": "coverageMsbuild"
  },
  "mavenCommandPattern": "^(?:cd\\s+([^;]+);\\s*)?(mvn|\\./mvnw)\\s+(.+)$",
  "toolCommandPatterns": {
    "npm": "^(?:cd\\s+(.+?)\\s*(?:;|&&)\\s*)?(npm)\\s+(.+)$",
    "gradle": "^(?:cd\\s+(.+?)\\s*(?:;|&&)\\s*)?(\\./gradlew|gradlew(?:\\.bat)?|gradle)\\s+(.+)$",
    "msbuild": "^(?:cd\\s+(.+?)\\s*(?:;|&&)\\s*)?(\"?(?:[^\"\\s]*[\\\\/])?MSBuild(?:\\.exe)?\"?)\\s+(.+)$",
    "xcodebuild": "^(?:(?:export\\s+[^;]+);\\s*)*(?:cd\\s+([^;]+);\\s*)?(xcodebuild)\\s+(.+)$"
  },
  "probeArguments": ["-v", "--version", "-version", "/?"],
  "xcodeActions": ["clean", "build", "test", "archive", "exportArchive"],
  "imageBuilderCommandPatterns": {
    "kaniko": {
      "displayName": "Kaniko",
      "pattern": "(?:^|\\s)/kaniko/executor(?:\\s|$)"
    },
    "buildkit": {
      "displayName": "BuildKit",
      "pattern": "(?:^|[;&|\\s])(?:buildctl\\s+build|docker\\s+buildx\\s+build)(?:\\s|$)"
    }
  },
  "helmCommandPattern": "(?:^|\\s)helm\\s+(lint|template|upgrade|status|rollback)(?:\\s|$)",
  "unsupportedCommandPatterns": {
    "modern .NET": "(?:^|[;&|\\s])dotnet(?:\\s|$)",
    "LLVM command": "(?:^|[;&|\\s])llvm-cov(?:\\s|$)"
  },
  "coverageTypes": {
    "coverageJest": {
      "format": "LCOV",
      "pathFields": ["LcovReportPath", "LcovReportFile"],
      "defaultPattern": "coverage/lcov.info",
      "qualityMetrics": {"Lines": "LINE", "Branches": "BRANCH", "Functions": "METHOD"}
    },
    "coverageMsbuild": {
      "format": "OPENCOVER",
      "pathFields": ["OpenCoverReportPath", "ReportFile"],
      "defaultPattern": "**/coverage.opencover.xml",
      "qualityMetrics": {"Lines": "LINE"}
    },
    "coverageLlvm": {
      "resultBundleFields": ["XcodeResultBundlePath", "ResultBundlePath"],
      "outputFile": ".jenkins-json-build/xcode-coverage.xml"
    }
  },
  "jacocoFields": {
    "classPattern": "classPattern",
    "execPattern": "execPattern",
    "InclusionPattern": "inclusionPattern",
    "ExclusionPattern": "exclusionPattern",
    "LineCoverage": "maximumLineCoverage",
    "InstructionCoverage": "maximumInstructionCoverage",
    "MethodCoverage": "maximumMethodCoverage",
    "BranchCoverage": "maximumBranchCoverage",
    "ClassCoverage": "maximumClassCoverage",
    "ComplexityCoverage": "maximumComplexityCoverage"
  }
}
