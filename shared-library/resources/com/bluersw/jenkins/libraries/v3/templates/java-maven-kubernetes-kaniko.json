{
  "schemaVersion": 3,
  "variables": {
    "JAVA_VERSION": "21",
    "MAVEN_IMAGE": "docker.io/library/maven:3.9.11-eclipse-temurin-21@sha256:6fdc855a6ed81d288ca7ca37ac6ff5e9308b612485c0801d70b25a858c83d237",
    "POD_HTTP_PROXY": "",
    "POD_HTTPS_PROXY": "",
    "POD_NO_PROXY": "",
    "MAVEN_EXECUTABLE": "./mvnw",
    "ENABLE_SONAR": false,
    "SONARQUBE_INSTALLATION": "SonarQube",
    "JUNIT_REPORTS": "**/target/surefire-reports/TEST-*.xml",
    "BUILD_ARTIFACTS": "**/target/*.jar",
    "IMAGE_REPOSITORY": "ghcr.io/example/change-me",
    "HELM_RELEASE": "change-me",
    "HELM_CHART": "deploy/helm",
    "KUBE_NAMESPACE": "default",
    "BUILDKIT_IMAGE": "docker.io/moby/buildkit:v0.32.2-rootless@sha256:504731e577c20559c00f968f33219f30115e70be29ab96728d1d06e963fc494b",
    "KANIKO_IMAGE": "gcr.io/kaniko-project/executor:v1.24.0-debug@sha256:2562c4fe551399514277ffff7dcca9a3b1628c4ea38cb017d7286dc6ea52f4cd",
    "KANIKO_EXECUTOR": "/kaniko/executor",
    "KANIKO_DOCKER_CONFIG": "/kaniko/.docker",
    "KANIKO_SECRET_NAME": "ghcr-push-config",
    "HELM_IMAGE": "docker.io/alpine/k8s:1.36.2@sha256:44ef4942e171939b9c665a4a84beb80e2dcdb9a24330d4651cfdfd2e9deecc47",
    "HELM_EXECUTABLE": "helm",
    "HELM_DRIVER": "configmap",
    "DEPLOY_SERVICE_ACCOUNT": "jenkins-deployer",
    "MAVEN_CPU_REQUEST": "250m",
    "MAVEN_MEMORY_REQUEST": "512Mi",
    "MAVEN_CPU_LIMIT": "2",
    "MAVEN_MEMORY_LIMIT": "2Gi",
    "IMAGE_BUILDER_CPU_REQUEST": "250m",
    "IMAGE_BUILDER_MEMORY_REQUEST": "512Mi",
    "IMAGE_BUILDER_CPU_LIMIT": "2",
    "IMAGE_BUILDER_MEMORY_LIMIT": "2Gi",
    "HELM_CPU_REQUEST": "100m",
    "HELM_MEMORY_REQUEST": "128Mi",
    "HELM_CPU_LIMIT": "1",
    "HELM_MEMORY_LIMIT": "512Mi"
  },
  "parameters": [],
  "agent": {
    "type": "kubernetes",
    "podTemplate": "java-kaniko-helm",
    "environment": {
      "HTTP_PROXY": "${POD_HTTP_PROXY}",
      "HTTPS_PROXY": "${POD_HTTPS_PROXY}",
      "NO_PROXY": "${POD_NO_PROXY}",
      "http_proxy": "${POD_HTTP_PROXY}",
      "https_proxy": "${POD_HTTPS_PROXY}",
      "no_proxy": "${POD_NO_PROXY}"
    }
  },
  "stages": [
    {
      "id": "test",
      "name": "Java tests",
      "container": "maven",
      "timeoutMinutes": 30,
      "steps": [
        {
          "type": "maven",
          "executable": "${MAVEN_EXECUTABLE}",
          "goals": ["clean", "test"]
        },
        {
          "type": "junit",
          "testResults": "${JUNIT_REPORTS}"
        },
        {
          "type": "jacoco",
          "execPattern": "**/target/jacoco.exec",
          "classPattern": "**/target/classes",
          "sourcePattern": "**/src/main/java"
        }
      ]
    },
    {
      "id": "quality",
      "name": "Java quality",
      "container": "maven",
      "condition": {
        "variable": "ENABLE_SONAR",
        "operator": "equals",
        "value": true
      },
      "timeoutMinutes": 20,
      "steps": [
        {
          "type": "sonarqube",
          "installation": "${SONARQUBE_INSTALLATION}",
          "executable": "${MAVEN_EXECUTABLE}",
          "goals": ["sonar:sonar"],
          "qualityGate": true,
          "abortPipeline": true
        }
      ]
    },
    {
      "id": "package",
      "name": "Java package",
      "container": "maven",
      "timeoutMinutes": 30,
      "steps": [
        {
          "type": "maven",
          "executable": "${MAVEN_EXECUTABLE}",
          "goals": ["package"],
          "arguments": ["-DskipTests"],
          "artifacts": ["${BUILD_ARTIFACTS}"]
        }
      ]
    },
    {
      "id": "image",
      "name": "OCI image",
      "container": "kaniko",
      "timeoutMinutes": 30,
      "steps": [
        {
          "type": "containerImage",
          "builder": "kaniko",
          "executor": "${KANIKO_EXECUTOR}",
          "context": ".",
          "dockerfile": "Dockerfile",
          "destinations": ["${IMAGE_REPOSITORY}:${BUILD_NUMBER}"],
          "cache": true
        }
      ]
    },
    {
      "id": "deploy",
      "name": "Helm deploy",
      "container": "helm",
      "timeoutMinutes": 20,
      "steps": [
        {
          "type": "helm",
          "action": "lint",
          "executable": "${HELM_EXECUTABLE}",
          "chart": "${HELM_CHART}"
        },
        {
          "type": "helm",
          "action": "template",
          "executable": "${HELM_EXECUTABLE}",
          "release": "${HELM_RELEASE}",
          "chart": "${HELM_CHART}",
          "namespace": "${KUBE_NAMESPACE}",
          "setValues": {
            "image.repository": "${IMAGE_REPOSITORY}",
            "image.digest": "${IMAGE_DIGEST}"
          }
        },
        {
          "type": "helm",
          "action": "upgrade",
          "executable": "${HELM_EXECUTABLE}",
          "release": "${HELM_RELEASE}",
          "chart": "${HELM_CHART}",
          "namespace": "${KUBE_NAMESPACE}",
          "createNamespace": true,
          "wait": true,
          "timeout": "10m",
          "rollbackOnFailure": true,
          "setValues": {
            "image.repository": "${IMAGE_REPOSITORY}",
            "image.digest": "${IMAGE_DIGEST}"
          }
        },
        {
          "type": "helm",
          "action": "status",
          "executable": "${HELM_EXECUTABLE}",
          "release": "${HELM_RELEASE}",
          "namespace": "${KUBE_NAMESPACE}"
        }
      ]
    }
  ],
  "post": {
    "always": [
      {
        "type": "archive",
        "artifacts": ".jenkins-json-build/image-digest",
        "allowEmptyArchive": true,
        "fingerprint": true
      }
    ]
  }
}
