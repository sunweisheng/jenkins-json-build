{
  "schemaVersion": 3,
  "extends": "android-gradle-static",
  "variables": {
    "ANDROID_IMAGE": "ghcr.io/sunweisheng/jenkins-json-build-android-arm64@sha256:4cb1328ef9bbc83d5545f90cedc2c11410548506591a61717fc6335e2ca44e5e",
    "POD_HTTP_PROXY": "",
    "POD_HTTPS_PROXY": "",
    "POD_NO_PROXY": "",
    "POD_RUN_AS_USER": 1000,
    "POD_RUN_AS_GROUP": 1000,
    "POD_FS_GROUP": 1000,
    "ANDROID_USER_HOME": "/home/jenkins",
    "ANDROID_SDK_ROOT": "/opt/android-sdk-linux",
    "ANDROID_AAPT2_PATH": "${ANDROID_SDK_ROOT}/build-tools/${ANDROID_BUILD_TOOLS_VERSION}/aapt2",
    "ANDROID_GRADLE_OPTS": "-Dorg.gradle.project.android.aapt2FromMavenOverride=${ANDROID_AAPT2_PATH}",
    "GRADLE_USER_HOME": "/home/jenkins/.gradle",
    "ANDROID_CPU_REQUEST": "500m",
    "ANDROID_MEMORY_REQUEST": "1Gi",
    "ANDROID_CPU_LIMIT": "3",
    "ANDROID_MEMORY_LIMIT": "3Gi"
  },
  "agent": {
    "type": "kubernetes",
    "podTemplate": "android-gradle",
    "environment": {
      "HTTP_PROXY": "${POD_HTTP_PROXY}",
      "HTTPS_PROXY": "${POD_HTTPS_PROXY}",
      "NO_PROXY": "${POD_NO_PROXY}",
      "http_proxy": "${POD_HTTP_PROXY}",
      "https_proxy": "${POD_HTTPS_PROXY}",
      "no_proxy": "${POD_NO_PROXY}"
    }
  },
  "stages": [
    {"id": "test", "container": "android"},
    {"id": "coverage", "container": "android"},
    {"id": "build", "container": "android"}
  ]
}
