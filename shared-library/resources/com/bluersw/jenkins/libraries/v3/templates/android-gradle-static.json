{
  "schemaVersion": 3,
  "variables": {
    "JAVA_VERSION": "21",
    "ANDROID_PLATFORM_VERSION": "36",
    "ANDROID_BUILD_TOOLS_VERSION": "36.0.0",
    "GRADLE_EXECUTABLE": "./gradlew",
    "GRADLE_TEST_TASK": "test",
    "GRADLE_BUILD_TASK": "assembleDebug",
    "ENABLE_COVERAGE": true,
    "JACOCO_REPORT": "**/build/reports/jacoco/**/*.xml",
    "ANDROID_ARTIFACTS": "**/build/outputs/**/*.apk"
  },
  "parameters": [],
  "agent": {"type": "static", "label": "", "requirements": {"architectures": ["amd64", "x86_64", "arm64", "aarch64"], "tools": ["java"]}},
  "stages": [
    {"id": "test", "name": "Android tests", "steps": [
      {"type": "gradle", "executable": "${GRADLE_EXECUTABLE}", "tasks": ["${GRADLE_TEST_TASK}"], "arguments": ["--no-daemon"]}
    ]},
    {"id": "coverage", "name": "Android coverage", "condition": {"variable": "ENABLE_COVERAGE", "operator": "equals", "value": true}, "steps": [
      {"type": "coverage", "reports": [{"format": "JACOCO", "pattern": "${JACOCO_REPORT}"}]}
    ]},
    {"id": "build", "name": "Android build", "steps": [
      {"type": "gradle", "executable": "${GRADLE_EXECUTABLE}", "tasks": ["${GRADLE_BUILD_TASK}"], "arguments": ["--no-daemon"], "artifacts": ["${ANDROID_ARTIFACTS}"]},
      {"type": "archive", "artifacts": "${ANDROID_ARTIFACTS}", "fingerprint": true}
    ]}
  ],
  "post": {"always": []}
}
