{
  "schemaVersion": 3,
  "extends": "react-native-android-static",
  "variables": {
    "NODE_IMAGE": "docker.io/library/node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d",
    "ANDROID_IMAGE": "ghcr.io/sunweisheng/jenkins-json-build-android-arm64@sha256:5be4a35cf77a1b6c389f1eb53b89c332222b6f320e9b1b43d32e20aae5d1b0c9",
    "POD_HTTP_PROXY": "",
    "POD_HTTPS_PROXY": "",
    "POD_NO_PROXY": "",
    "POD_RUN_AS_USER": 1000,
    "POD_RUN_AS_GROUP": 1000,
    "POD_FS_GROUP": 1000,
    "NODE_USER_HOME": "/home/jenkins",
    "ANDROID_USER_HOME": "/home/jenkins",
    "ANDROID_SDK_ROOT": "/opt/android-sdk-linux",
    "ANDROID_AAPT2_PATH": "${ANDROID_SDK_ROOT}/build-tools/${ANDROID_BUILD_TOOLS_VERSION}/aapt2",
    "ANDROID_GRADLE_OPTS": "-Dorg.gradle.project.android.aapt2FromMavenOverride=${ANDROID_AAPT2_PATH} -Dorg.gradle.java.installations.paths=/usr/lib/jvm/java-17-openjdk-arm64,/usr/lib/jvm/java-21-openjdk-arm64 -Dorg.gradle.java.installations.auto-download=false",
    "GRADLE_USER_HOME": "/home/jenkins/.gradle",
    "SHARED_NODE_BINARY": "/opt/jenkins-toolchain/node",
    "NODE_CPU_REQUEST": "250m",
    "NODE_MEMORY_REQUEST": "512Mi",
    "NODE_CPU_LIMIT": "2",
    "NODE_MEMORY_LIMIT": "2Gi",
    "ANDROID_CPU_REQUEST": "500m",
    "ANDROID_MEMORY_REQUEST": "1Gi",
    "ANDROID_CPU_LIMIT": "3",
    "ANDROID_MEMORY_LIMIT": "3Gi"
  },
  "agent": {
    "type": "kubernetes",
    "podTemplate": "react-native-android",
    "environment": {
      "HTTP_PROXY": "${POD_HTTP_PROXY}",
      "HTTPS_PROXY": "${POD_HTTPS_PROXY}",
      "NO_PROXY": "${POD_NO_PROXY}",
      "http_proxy": "${POD_HTTP_PROXY}",
      "https_proxy": "${POD_HTTPS_PROXY}",
      "no_proxy": "${POD_NO_PROXY}"
    }
  },
  "stages": [
    {"id": "install", "container": "node"},
    {"id": "test", "steps": [
      {"type": "npm", "container": "node", "executable": "${NPM_EXECUTABLE}", "command": "${NPM_TEST_COMMAND}", "workDir": "${NPM_WORK_DIR}"},
      {"type": "gradle", "container": "android", "executable": "${GRADLE_EXECUTABLE}", "tasks": ["${GRADLE_TEST_TASK}"], "arguments": ["--no-daemon"], "workDir": "${GRADLE_WORK_DIR}", "environment": {"NODE_BINARY": "${SHARED_NODE_BINARY}"}}
    ]},
    {"id": "coverage", "container": "node"},
    {"id": "quality", "container": "node"},
    {"id": "build", "container": "android", "steps": [
      {"type": "gradle", "executable": "${GRADLE_EXECUTABLE}", "tasks": ["${GRADLE_BUILD_TASK}"], "arguments": ["--no-daemon"], "workDir": "${GRADLE_WORK_DIR}", "environment": {"NODE_BINARY": "${SHARED_NODE_BINARY}"}, "artifacts": ["${ANDROID_ARTIFACTS}"]},
      {"type": "archive", "artifacts": "${ANDROID_ARTIFACTS}", "fingerprint": true}
    ]}
  ]
}
